# Copy to .env and fill in. NEVER put real values in this file — it is committed.
#   cp .env.example .env

# --- Database (required) ---
# Local Docker Postgres (see docker-compose.yml):
#   postgresql://tracker:tracker@localhost:5432/tracker
# Hosted (Neon / Supabase / Vercel Postgres): paste their connection string.
# Runtime pool. On Neon this MUST be the -pooler host, or concurrent
# requests will exhaust direct Postgres connections.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth (required) ---
# Generate a fresh one per environment:
#   openssl rand -base64 32
AUTH_SECRET=""
# Public origin of this deployment. Must match the port you actually run on,
# and must be the https:// production URL when deployed.
NEXTAUTH_URL="http://localhost:3000"

# --- Google sign-in (optional) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Register the redirect URI EXACTLY, matching NEXTAUTH_URL:
#   <NEXTAUTH_URL>/api/auth/callback/google
# While either value is blank the "Continue with Google" button stays hidden,
# so the app runs fine without Google configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email OTP delivery (optional in dev, required in production) ---
# With SMTP_HOST blank the sign-in code is printed to the server console in
# development, and refused outright in production.
# Gmail: use an App Password (Google Account -> Security -> App passwords),
# never your account password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Expense Tracker <no-reply@example.com>"

# Migrations only. PgBouncer (the -pooler host) cannot run DDL, so Prisma needs
# the direct endpoint here. Same credentials, hostname without "-pooler".
DIRECT_URL=

# Prisma pool size PER INSTANCE. Serverless (Vercel): 5 — every warm lambda
# holds its own pool. One long-lived Node server: 20-40.
DB_CONNECTION_LIMIT=5

# next-auth v5 infers this from VERCEL_URL on Vercel; set it explicitly once you
# put a custom domain in front, and add the same origin's
# /api/auth/callback/google to the Google OAuth client.
# AUTH_URL=https://your-domain.com
